DirectoryIndex index.html index.php

# Keep contact details and mail links current after static deployments.
# SiteGround requires a one-time Dynamic Cache flush for existing entries.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "private, no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(admin(?:/.*)?)$ https://codeflow-studios-production.up.railway.app/$1 [R=302,L]
RewriteRule ^shop/?$ https://codeflowshop.myshopify.com/ [R=302,L]
RewriteRule ^nightly-build-club/?$ /flow-community/ [R=301,L]
RewriteRule ^api/marketing/index\.php$ - [L]
RewriteRule ^api/marketing/.*$ api/marketing/index.php [L]
</IfModule>
