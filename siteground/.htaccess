DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^shop/?$ https://codeflowshop.myshopify.com/ [R=302,L]
RewriteRule ^nightly-build-club/?$ /flow-community/ [R=301,L]
RewriteRule ^api/marketing/index\.php$ - [L]
RewriteRule ^api/marketing/.*$ api/marketing/index.php [L]
</IfModule>
